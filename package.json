{
  "name": "master-duel-deck-akinator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An Akinator-style deck recommender for new Yu-Gi-Oh! Master Duel players.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:archetypes": "node scripts/sync-archetypes.mjs",
    "sync:cards": "vite-node scripts/sync-cards.ts",
    "sync:ages": "node scripts/sync-archetype-ages.mjs",
    "sync:facts": "node scripts/sync-archetype-facts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
